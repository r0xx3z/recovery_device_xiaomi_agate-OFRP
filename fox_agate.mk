# OrangeFox-specific settings
OF_DONT_PATCH_ENCRYPTED_DEVICE := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_NO_MIUI_PATCH_WARNING := 1
OF_ENABLE_USB_STORAGE := 1
OF_BIND_MOUNT_SDCARD_ON_FORMAT := 1

# avb 2.0
OF_PATCH_AVB20 := 1

# Decryption
OF_FBE_METADATA_MOUNT_IGNORE := 1

# Magisk & Boot Patching
OF_USE_MAGISKBOOT := 1
OF_USE_MAGISKBOOT_FOR_ALL_PATCHES := 1

# OrangeFox GUI settings
OF_SCREEN_H := 2400
OF_STATUS_H := 100
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_CLOCK_POS := 1
OF_FLASHLIGHT_ENABLE := 1
OF_FL_PATH1 := /sys/class/leds/torch-light0
OF_FL_PATH2 := /sys/class/leds/torch-light1

# # OTA for custom ROMs
OF_SUPPORT_ALL_PAYLOAD_OTA_UPDATES := 1
OF_KEEP_DM_VERITY_FORCED_ENCRYPTION := 1
OF_KEEP_DM_VERITY := 0
# OF_SUPPORT_ALL_BLOCK_OTA_UPDATES := 1
OF_FIX_OTA_UPDATE_MANUAL_FLASH_ERROR := 1

# f2fs compression
OF_ENABLE_FS_COMPRESSION := 1

# FRP
OF_ENABLE_FRP_ADDON := 1

# Device stuff
OF_DEFAULT_KEYMASTER_VERSION=4.1
OF_USE_LEGACY_BATTERY_SERVICES=1
OF_FORCE_PREBUILT_KERNEL=1
OF_ENABLE_LPTOOLS := 1
OF_ENABLE_ALL_PARTITION_TOOLS=1
OF_QUICK_BACKUP_LIST := /boot;/data;/dtbo;
OF_WIPE_METADATA_AFTER_DATAFORMAT=1
OF_RUN_POST_FORMAT_PROCESS=1

# Maximun permissible splash image size (in kilobytes); do "NOT" increase
OF_SPLASH_MAX_SIZE := 130
